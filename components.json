{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-luma",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@smoothui": "https://smoothui.dev/r/{name}.json",
    "@gooseui": "https://gooseui.pro/r/{name}.json",
    "@uitripled": "https://ui.tripled.work/r/{name}.json",
    "@diceui": "https://diceui.com/r/{style}/{name}.json",
    "@commercn": "https://commercn.com/r/{name}.json",
    "@componentry": "https://componentry.fun/r/{name}.json"
  }
}
